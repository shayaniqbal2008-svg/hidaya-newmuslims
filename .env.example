# Copy to .env.local and fill in. NEVER commit .env.local (it's in .gitignore).

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...   # or NEXT_PUBLIC_SUPABASE_ANON_KEY on older projects
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...                   # server only: reminders, account deletion, setup script

# The app's public address (http://localhost:3000 locally; the Vercel URL in production)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Encrypts reflections and guide chats. Generate once: openssl rand -base64 32
# Back it up somewhere safe: losing it makes stored notes and chats unreadable.
APP_ENCRYPTION_KEY=

# Anthropic (console.anthropic.com → API keys; set a monthly spend limit)
ANTHROPIC_API_KEY=
GUIDE_MODEL=claude-sonnet-5-5        # or claude-haiku-4-5, decided by the red-team eval
CRISIS_MODEL=claude-haiku-4-5
GUIDE_DAILY_LIMIT=40                 # messages per convert per day

# Web push reminders: `npm run vapid` prints these
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Email reminders (resend.com)
RESEND_API_KEY=
# Address only: the sender name is "Hidaya", or "Daily" for converts in discreet mode.
REMINDER_FROM_ADDRESS=reminders@yourdomain.com

# Protects the reminder job URL. Generate: openssl rand -hex 24
CRON_SECRET=

# Lesson preview pages (/preview) in production. Leave unset normally.
# PREVIEW_ENABLED=1
